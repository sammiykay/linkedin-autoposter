# Create an app at https://www.linkedin.com/developers/apps
# Products needed: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# Pin this and bump when LinkedIn sunsets it (format YYYYMM)
LINKEDIN_VERSION=202610

# Dashboard login password (REQUIRED, the dashboard refuses to run without it)
APP_PASSWORD=change-me-to-something-long

# Worker settings
CHECK_EVERY_SECONDS=30
MAX_RETRIES=3
# Posts older than this many hours past due are marked 'missed' instead of fired
MISSED_AFTER_HOURS=24

# Alert delivery: use Resend HTTPS API (recommended); smtp remains supported.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender on your verified Resend domain, e.g. Postdesk <alerts@yourdomain.com>
RESEND_FROM=
# Recipient for operational alerts
ALERT_TO=

# Only needed when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Local dashboard port; keep 8501 when using the supplied nginx example
DASHBOARD_PORT=8501
# Set true only when accessing the dashboard through HTTPS
COOKIE_SECURE=false
