[Unit]
Description=LinkedIn Autoposter Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__/current
Environment="APP_ENV_FILE=__APP_DIR__/.env" "APP_DATA_DIR=__APP_DIR__/data" "APP_MEDIA_DIR=__APP_DIR__/media" "APP_LOG_DIR=__APP_DIR__/logs" "APP_BACKUP_DIR=__APP_DIR__/backups"
ExecStart="__APP_DIR__/current/venv/bin/python" -m app.monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths="__APP_DIR__"
